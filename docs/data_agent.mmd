---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	sql_analyst(sql_analyst)
	etl_analyst(etl_analyst)
	decline(decline)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	router -.-> decline;
	router -.-> etl_analyst;
	router -.-> sql_analyst;
	decline --> __end__;
	etl_analyst --> __end__;
	sql_analyst --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
