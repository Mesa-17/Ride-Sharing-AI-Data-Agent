# Copy this file to .env and fill it in. Never commit .env.

# Anthropic API key used by all agents
ANTHROPIC_API_KEY=

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# Admin user: only feed_db.py uses it, to create tables, load data and create the agent role
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Read-only user the SQL agent connects with (feed_db.py creates it with this password)
DB_AGENT_USER=agent_readonly
DB_AGENT_PASSWORD=

# Optional tuning
# AGENT_MAX_ROWS=100
# AGENT_STATEMENT_TIMEOUT_MS=5000
# AGENT_MAX_SQL_ATTEMPTS=3
# LLM_MODEL_LOW=claude-haiku-4-5
# LLM_MODEL_MEDIUM=claude-sonnet-5
# LLM_MODEL_HIGH=claude-opus-5

# Hosted Postgres (Neon etc.) needs SSL
# DB_SSLMODE=require

# Web API (api/server.py)
# ALLOWED_ORIGINS=https://sandeepmenon.dev,http://localhost:4321
# DEMO_PER_HOUR=5
# DEMO_PER_DAY=300
